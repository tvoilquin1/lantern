# Anthropic — AI companion
ANTHROPIC_API_KEY=

# Voyage AI — embeddings for RAG
VOYAGE_AI_API_KEY=

# Supabase — auth and database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel cron — verifies requests to /api/cron/* actually come from Vercel's
# cron scheduler (sent as `Authorization: Bearer <value>`). Optional locally.
CRON_SECRET=

# Resend — emergency-contact outreach email (5+ missed daily check-ins).
# Without this set, the cron logs a warning and skips the send rather than
# failing. RESEND_FROM_EMAIL is optional and defaults to a placeholder sender
# — see lib/notifications/emergencyContactEmail.ts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
